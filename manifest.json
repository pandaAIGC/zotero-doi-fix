{
  "manifest_version": 2,
  "name": "DOI Fix",
  "version": "1.1.3",
  "description": "Automatically retrieve and validate DOIs for Zotero items using the Crossref API. Compatible with Zotero 7, 8, and 9.",
  "author": "pandaAIGC",
  "homepage_url": "https://github.com/pandaAIGC/zotero-doi-fix",

  "applications": {
    "zotero": {
      "id": "doi-fix@zotero.org",
      "update_url": "https://raw.githubusercontent.com/pandaAIGC/zotero-doi-fix/main/updates.json",
      "strict_min_version": "7.0",
      "strict_max_version": "9.*"
    }
  },

  "icons": {
    "48": "icons/icon@48.png",
    "96": "icons/icon@96.png"
  }
}
